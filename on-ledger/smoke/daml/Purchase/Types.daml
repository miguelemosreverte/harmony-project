module Purchase.Types where

import qualified Story as S

data Setup = Setup with
    buyerAgentName : Text
    sellerAgentName : Text
    property : Text
    documents : Text
    decision : Text
    evidence : Text
  deriving (Eq, Show)

data Input = Input with namespace : Text; bankName : Text; buyerName : Text; setup : Setup; actions : [S.Attempt]
  deriving (Eq, Show)
