module Story where

import Daml.Script
import Financing
import Harmonia.Action
import Harmonia.Workflow

data Attempt = Attempt with
    id : Text
    actor : Text
    action : Text
  deriving (Eq, Show)

data Input = Input with
    namespace : Text
    bankName : Text
    buyerName : Text
    initialStatus : Text
    workflow : Optional Text
    actions : [Attempt]
  deriving (Eq, Show)

data Step = Step with
    id : Text
    outcome : Text
    reason : Optional Text
    application : Text
    workflow : Optional Text
    consumed : Bool
    activeContracts : Int
    visibleTo : [Text]
    inputContract : Text
    outputContract : Text
    rawError : Optional Text
  deriving (Eq, Show)

run : Input -> Script [Step]
run input = script do
  bank <- allocateParty (input.namespace <> "-" <> input.bankName)
  buyer <- allocateParty (input.namespace <> "-" <> input.buyerName)
  original <- submit bank do
    createCmd Application with bank; buyer; reference = "application"; status = input.initialStatus
  workflowId <- case input.workflow of
    None -> pure None
    Some "approval" -> Some <$> submit bank do
      createCmd WorkflowInstance with
        owner = bank; readers = [buyer]; assignee = bank; subject = "application"
        action = toInterfaceContractId @StepAction original; status = "waiting"
    Some _ -> abort "Unsupported workflow"
  execute input bank buyer original workflowId input.actions

execute : Input -> Party -> Party -> ContractId Application -> Optional (ContractId WorkflowInstance) -> [Attempt] -> Script [Step]
execute input bank buyer current workflowId remaining = case remaining of
  [] -> pure []
  attempt :: rest -> do
    assertMsg "Unsupported action" (attempt.action == "approve-financing")
    actor <- if attempt.actor == input.bankName then pure bank
      else if attempt.actor == input.buyerName then pure buyer
      else abort "Unknown actor"
    result <- trySubmit actor do
      case workflowId of
        None -> (\next -> (next, None)) <$> exerciseCmd current Approve
        Some cid -> (\(nextWorkflow, nextAction) ->
          (fromInterfaceContractId @Application nextAction, Some nextWorkflow)) <$> exerciseCmd cid Advance
    (next, nextWorkflowId, outcome, reason, rawError) <- case result of
      Right (cid, nextWorkflow) -> pure (cid, nextWorkflow, "committed", None, None)
      Left error@AuthorizationError{} -> pure (current, workflowId, "rejected", Some "unauthorized", Some (show error))
      Left error@UnhandledException{} -> pure (current, workflowId, "rejected", Some "application-rejected", Some (show error))
      Left error@UserError{} -> pure (current, workflowId, "rejected", Some "application-rejected", Some (show error))
      Left error@(FailureStatusError failure)
        | failure.errorId == "UNHANDLED_EXCEPTION/DA.Exception.AssertionFailed:AssertionFailed" ->
          pure (current, workflowId, "rejected", Some "application-rejected", Some (show error))
        | failure.errorId == "DAML_AUTHORIZATION_ERROR" ->
          pure (current, workflowId, "rejected", Some "unauthorized", Some (show error))
      Left error -> abort ("Unexpected ledger error: " <> show error)
    previous <- queryContractId bank current
    bankView <- queryContractId bank next
    buyerView <- queryContractId buyer next
    allActive <- query @Application bank
    workflowState <- case nextWorkflowId of
      None -> pure None
      Some cid -> do
        observedWorkflow <- queryContractId bank cid
        pure (Some (optional "missing" (.status) observedWorkflow))
    let observed = Step with
          id = attempt.id
          outcome
          reason
          application = optional "missing" (.status) bankView
          workflow = workflowState
          consumed = previous == None
          activeContracts = length allActive
          visibleTo = (if buyerView /= None then [input.buyerName] else []) <>
            (if bankView /= None then [input.bankName] else [])
          inputContract = show current
          outputContract = show next
          rawError
    later <- execute input bank buyer next nextWorkflowId rest
    pure (observed :: later)
