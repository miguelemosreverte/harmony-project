module Purchase where

import Daml.Script
import qualified Purchase.Types as P
import Purchase.Model
import Purchase.Setup
import Purchase.Execution
import Purchase.Observe

run : P.Input -> Script Observation
run input = script do
  (context, initial) <- initialize input
  (steps, final) <- execute context initial input.actions
  views <- partyViews context final
  pure Observation with actors = context.actors; steps; views
