-- @module.slice financing
-- @module.role Signed result
-- @module.summary The verified result records issuer, consumer, subject, decision, and the permitted continuation.
module Harmonia.Result where

-- A signed, single-use result contains only the facts its consumer needs.
template VerifiedResult with
    issuer : Party
    consumer : Party
    readers : [Party]
    subject : Text
    decision : Text
    continuation : Text
  where
    signatory issuer
    observer consumer, readers

    choice Consume : ()
      controller consumer
      do pure ()
