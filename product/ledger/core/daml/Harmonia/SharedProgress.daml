module Harmonia.SharedProgress where

import Harmonia.Result

template SharedProgress with
    owner : Party
    issuer : Party
    readers : [Party]
    subject : Text
    status : Text
  where
    signatory owner, issuer
    observer issuer, readers
    ensure status == "waiting" || status == "complete"

    choice Continue : ContractId SharedProgress
      with result : Optional (ContractId VerifiedResult)
      controller owner
      do
        assertMsg "Progress must be waiting" (status == "waiting")
        proof <- case result of
          Some cid -> pure cid
          None -> abort "Approval result required"
        evidence <- fetch proof
        assertMsg "Result issuer, consumer, subject, and decision must match"
          (evidence.issuer == issuer && evidence.consumer == owner && evidence.subject == subject && evidence.decision == "approved" && evidence.continuation == "shared-progress:" <> subject)
        exercise proof Consume
        create this with status = "complete"

-- The issuer authorizes a narrowly scoped, initially waiting shared instance.
template ProgressProposal with
    issuer : Party
    owner : Party
    readers : [Party]
    subject : Text
  where
    signatory issuer
    observer owner, readers

    choice Accept : ContractId SharedProgress
      controller owner
      do create SharedProgress with owner; issuer; readers; subject; status = "waiting"
