#!/usr/bin/env bash
set -euo pipefail
harmonia_scripts="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
case "${1:-}" in
  serve|generate-bindings|resolve-packages) exec "$harmonia_scripts/run-scala" service harmonia.app.Main "$@" ;;
  book|export-book|serve-book|book-links) exec "$harmonia_scripts/run-scala" bookExport harmonia.book.Main "$@" ;;
  *) exec "$harmonia_scripts/run-scala" tools harmonia.tools.Main "$@" ;;
esac
