#!/usr/bin/env bash
set -euo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/environment"
"$HARMONIA_ROOT/scripts/build-product"
source "$HARMONIA_ROOT/scripts/ledger-packages"
cd "$HARMONIA_ROOT"
sbt --batch 'scalafmtCheckAll' 'tools/compile' 'reader/fastLinkJS'
for harmonia_package in "${harmonia_assembly_packages[@]}"; do
  scripts/daml build --package-root "$harmonia_package"
done
