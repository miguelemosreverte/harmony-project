#!/usr/bin/env bash
set -euo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/environment"
harmonia_root="$HARMONIA_ROOT"
for harmonia_package in interfaces core financing legacy-financing bindings private-financing review property-financing property-offer source-custody destination-custody transfer smoke; do
  cd "$harmonia_root/on-ledger/$harmonia_package"
  "$harmonia_root/scripts/daml" build
done
cd "$harmonia_root/off-ledger"
sbt --batch 'scalafmtCheckAll' 'jvm/compile' 'browser/fastLinkJS' 'jvm/run resolve-packages'

for harmonia_package in metadata-receipts package-example; do
  "$harmonia_root/scripts/daml" build --package-root "$harmonia_root/on-ledger/$harmonia_package"
done
