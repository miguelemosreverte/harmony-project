#!/usr/bin/env python3
"""Serve the design preview locally without starting a JVM or ledger."""
from functools import partial
from http.server import SimpleHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path
import argparse

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument("--port", type=int, default=56202)
args = parser.parse_args()
root = Path(__file__).resolve().parents[1]
handler = partial(SimpleHTTPRequestHandler, directory=str(root))
with ThreadingHTTPServer(("127.0.0.1", args.port), handler) as server:
    print(f"Harmonia 0.2 design: http://127.0.0.1:{args.port}/design/0.2/book-overview.html", flush=True)
    print("Ctrl-C stops this preview. No ledger is started.", flush=True)
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        pass
